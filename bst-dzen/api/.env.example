APP_NAME="BST Dzen System"
APP_ENV=local
APP_KEY=
# На проде: APP_ENV=production, APP_DEBUG=false
APP_DEBUG=true
# Домен/адрес, по которому открыт UI; для прод-домена указать его (например https://dzen.example.ru)
APP_URL=http://localhost:8090

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Соответствует сервису mysql в docker-compose.yml
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=dzen
DB_USERNAME=dzen
DB_PASSWORD=dzen_secret

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MAIL_MAILER=log

VITE_APP_NAME="${APP_NAME}"

# Cookie-аутентификация SPA: добавить домен прод-сервера (с портом, если не 80/443)
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8090

# LLM (Bothub): секреты выдавались отдельно — не коммитить реальные значения
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL_DEFAULT=
